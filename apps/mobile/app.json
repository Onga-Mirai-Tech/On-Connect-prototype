{
  "expo": {
    "name": "On-Connect",
    "slug": "on-connect",
    "scheme": "onconnect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#66FFCC",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#66FFCC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tech.ongamirai.onconnect",
      "infoPlist": {
        "UIBackgroundModes": [
          "voip",
          "audio"
        ],
        "NSMicrophoneUsageDescription": "音声通話でマイクを使用します",
        "NSCameraUsageDescription": "チャット・掲示板に写真を添付するためカメラを使用します",
        "NSPhotoLibraryUsageDescription": "チャット・掲示板に写真を添付するためカメラロールを使用します"
      }
    },
    "android": {
      "package": "tech.ongamirai.onconnect",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#66FFCC"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "チャット・掲示板に写真を添付するためカメラロールを使用します",
          "cameraPermission": "チャット・掲示板に写真を添付するためカメラを使用します"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b8b4059e-7f60-4ba3-9d98-8e0f0d953025"
      }
    },
    "owner": "onga-mirai-tech"
  }
}
