# Cognito/API接続設定。実際の値は初回デプロイ後に`cdk deploy`の出力（CfnOutput）から取得して
# .env（gitignore対象）へコピーする。デプロイ前は空のままで起動でき、実際にログインを試みた時点で
# Amplify側のエラーになる（想定内の挙動）。EXPO_PUBLIC_接頭辞はExpoが自動でprocess.envに埋め込む。
EXPO_PUBLIC_USER_POOL_ID=
EXPO_PUBLIC_USER_POOL_CLIENT_ID=
EXPO_PUBLIC_AWS_REGION=ap-northeast-1
EXPO_PUBLIC_API_URL=
